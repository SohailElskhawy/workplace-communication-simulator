# Next.js (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Express API (apps/api)
PORT=4000
WEB_ORIGIN=http://localhost:3000
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# OpenRouter: exact model IDs only; do not use automatic model routing
OPENROUTER_API_KEY=sk-or-v1-replace_me
ROLEPLAY_MODEL=deepseek/deepseek-v4-flash-0731
EVALUATION_MODEL=openai/gpt-5.6-luna-pro
TRANSCRIPTION_MODEL=openai/whisper-large-v3-turbo
# TBD until Milestone 11; optional TTS must remain disabled while blank
TTS_MODEL=
ROLEPLAY_TIMEOUT_MS=15000
EVALUATION_TIMEOUT_MS=30000
TRANSCRIPTION_TIMEOUT_MS=20000
TTS_TIMEOUT_MS=15000

# Neon: pooled runtime URL and direct migration URL
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/kalemny?sslmode=require
DIRECT_URL=postgresql://user:password@ep-example.region.aws.neon.tech/kalemny?sslmode=require
