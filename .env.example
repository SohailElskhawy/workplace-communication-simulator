# Next.js (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Express API (apps/api)
PORT=4000
WEB_ORIGIN=http://localhost:3000
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# OpenRouter: exact model IDs only; do not use automatic model routing
OPENROUTER_API_KEY=sk-or-v1-replace_me
ROLEPLAY_MODEL=google/gemini-2.5-flash-lite
ROLEPLAY_PROMPT_VERSION=roleplay-v2
EVALUATION_MODEL=openai/gpt-5.6-luna-pro
EVALUATION_PROMPT_VERSION=evaluation-v2
TRANSCRIPTION_MODEL=openai/whisper-large-v3-turbo
TTS_MODEL=hexgrad/kokoro-82m
ROLEPLAY_TIMEOUT_MS=25000
EVALUATION_TIMEOUT_MS=60000
TRANSCRIPTION_TIMEOUT_MS=25000
TTS_TIMEOUT_MS=15000

# Process-local API protection (Release 1 single-service deployment)
GENERAL_RATE_LIMIT_WINDOW_MS=60000
GENERAL_RATE_LIMIT_MAX=120
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=30

# Optional exception monitoring; leave blank to disable locally
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_RELEASE=

# Optional ElevenLabs realtime voice + canonical post-call transcript import.
# Configure the first three to enable live voice; configure the webhook secret
# to accept signed post_call_transcription deliveries at the API endpoint.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_TOOL_SECRET=
ELEVENLABS_WEBHOOK_SECRET=

# Neon: pooled runtime URL and direct migration URL
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/kalemny?sslmode=require
DIRECT_URL=postgresql://user:password@ep-example.region.aws.neon.tech/kalemny?sslmode=require
