generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlanTier {
  FREE
  PLUS
  PRO
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  authProviderUserId String    @unique
  plan               PlanTier  @default(FREE)
  planExpiresAt      DateTime? @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  simulationAttempts   SimulationAttempt[]
  aiUsageEvents        AiUsageEvent[]
  practiceUsageLedgers PracticeUsageLedger[]
  scenarios            Scenario[]
}

model Scenario {
  id         String   @id @default(uuid()) @db.Uuid
  key        String
  version    Int
  title      String
  category   String
  summary    String
  definition Json
  isActive   Boolean  @default(false)
  userId     String?  @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  user               User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  simulationAttempts SimulationAttempt[]

  @@unique([key, version])
  @@index([key, isActive])
  @@index([userId, isActive])
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum AttemptStatus {
  ACTIVE
  EVALUATING
  COMPLETED
  EVALUATION_FAILED
  ABANDONED
}

enum InputMethod {
  TEXT
  VOICE
}

enum InteractionMode {
  PUSH_TO_TALK
  REALTIME
}

enum TurnStatus {
  PENDING
  COMPLETED
  FAILED
}

enum AiOperation {
  ROLEPLAY
  EVALUATION
  TRANSCRIPTION
  TTS
  SCENARIO_GENERATION
}

enum AiUsageStatus {
  SUCCESS
  FAILED
}

enum UniversalSkill {
  CLARITY
  ASSERTIVENESS
  EMPATHY
  STRUCTURE
  CONCISENESS
}

model SimulationAttempt {
  id                  String        @id @default(uuid()) @db.Uuid
  userId              String        @db.Uuid
  scenarioId          String        @db.Uuid
  retryOfAttemptId    String?       @db.Uuid
  variationId         String?
  difficulty          Difficulty
  interactionMode     InteractionMode @default(PUSH_TO_TALK)
  status              AttemptStatus @default(ACTIVE)
  startedAt           DateTime      @default(now()) @db.Timestamptz(3)
  endedAt             DateTime?     @db.Timestamptz(3)
  expiresAt           DateTime      @db.Timestamptz(3)
  progressEligible    Boolean       @default(false)
  evaluationStartedAt DateTime?     @db.Timestamptz(3)
  evaluationClaimedAt DateTime?     @db.Timestamptz(3)
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)

  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenario          Scenario            @relation(fields: [scenarioId], references: [id], onDelete: Restrict)
  retryOfAttempt    SimulationAttempt?  @relation("AttemptRetries", fields: [retryOfAttemptId], references: [id], onDelete: SetNull)
  retryAttempts     SimulationAttempt[] @relation("AttemptRetries")
  conversationTurns ConversationTurn[]
  aiUsageEvents     AiUsageEvent[]
  evaluation        Evaluation?
  realtimeConversations RealtimeConversation[]
  practiceUsageLedgers PracticeUsageLedger[]

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([userId, status, progressEligible, endedAt(sort: Desc)])
  @@index([retryOfAttemptId])
}

model ConversationTurn {
  id              String      @id @default(uuid()) @db.Uuid
  attemptId       String      @db.Uuid
  sequence        Int
  clientRequestId String      @db.VarChar(128)
  inputMethod     InputMethod
  userText        String      @db.Text
  assistantText   String?     @db.Text
  status              TurnStatus @default(PENDING)
  generationStartedAt DateTime   @default(now()) @db.Timestamptz(3)
  createdAt           DateTime   @default(now()) @db.Timestamptz(3)
  completedAt         DateTime?  @db.Timestamptz(3)

  attempt SimulationAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, sequence])
  @@unique([attemptId, clientRequestId])
  @@index([attemptId, status])
}

/**
 * Maps an ElevenLabs realtime `conversation_id` to exactly one
 * SimulationAttempt. Created by the owner-authenticated bind endpoint right
 * after a live session starts; consumed by the post-call transcription
 * webhook to resolve the attempt without trusting any browser-supplied
 * identity. One attempt may have several live conversations (restarted
 * calls); one ElevenLabs conversation ever belongs to one attempt.
 */
model RealtimeConversation {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @unique @db.VarChar(128)
  attemptId      String   @db.Uuid
  transcriptImportedAt DateTime? @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  attempt SimulationAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
}

model Evaluation {
  id               String         @id @default(uuid()) @db.Uuid
  attemptId        String         @unique @db.Uuid
  clarity          Int
  assertiveness    Int
  empathy          Int
  structure        Int
  conciseness      Int
  universalScore   Int
  scenarioScore    Int
  overallScore     Int
  objectiveResults Json
  strengths        Json
  improvements     Json
  moments          Json
  nextFocusSkill   UniversalSkill
  nextFocusReason  String         @db.Text
  summary          String         @db.Text
  model            String
  promptVersion    String
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)

  attempt SimulationAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

model AiUsageEvent {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @db.Uuid
  attemptId       String?       @db.Uuid
  operation       AiOperation
  provider        String
  model           String
  status          AiUsageStatus
  latencyMs       Int
  inputTokens     Int?
  outputTokens    Int?
  audioDurationMs Int?
  estimatedCost   Decimal?      @db.Decimal(18, 12)
  errorCode       String?
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempt SimulationAttempt? @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId, createdAt])
  @@index([operation, createdAt])
}

model PracticeUsageLedger {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  attemptId String?  @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempt SimulationAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([attemptId])
}

