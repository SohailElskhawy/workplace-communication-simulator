generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String   @id @default(uuid()) @db.Uuid
  authProviderUserId String   @unique
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)
}

model Scenario {
  id         String   @id @default(uuid()) @db.Uuid
  key        String
  version    Int
  title      String
  category   String
  summary    String
  definition Json
  isActive   Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@unique([key, version])
  @@index([key, isActive])
}
