{
  "name": "kalemny",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @kalemny/web --filter @kalemny/api dev",
    "dev:web": "corepack pnpm --filter @kalemny/web dev",
    "dev:api": "corepack pnpm --filter @kalemny/api dev",
    "build": "corepack pnpm -r build",
    "typecheck": "corepack pnpm -r typecheck",
    "lint": "eslint apps/api/src packages/contracts/src vitest.config.ts && corepack pnpm --filter @kalemny/web lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "9.39.3",
    "@types/node": "26.4.0",
    "eslint": "9.39.3",
    "eslint-config-next": "16.3.3",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
